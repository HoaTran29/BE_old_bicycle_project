# =====================
# Cách dùng
# 1. Copy file này thành `.env`
# 2. Điền giá trị thật cho môi trường của bạn
# 3. Không commit file `.env` chứa secret thật
# =====================

# =====================
# Database
# Bắt buộc cho mọi môi trường chạy app thật
# Với backend Spring Boot chạy lâu dài:
# - Ưu tiên direct connection nếu môi trường hỗ trợ IPv6
# - Nếu môi trường chỉ có IPv4, ưu tiên session pooler
# =====================
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.kfkzxghznwgbbarfsqre
DB_PASSWORD=your_database_password

# =====================
# JWT
# Bắt buộc
# Nên dùng chuỗi dài, ngẫu nhiên, khó đoán
# =====================
JWT_SECRET=replace_with_a_long_random_secret_key_for_jwt_signing

# =====================
# Mail
# Cần nếu muốn dùng verify email và reset password qua email
# Dev có thể dùng tài khoản test
# =====================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# =====================
# Google OAuth2
# Chỉ cần nếu muốn bật đăng nhập Google
# =====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =====================
# SePay
# Dev local nên để mock mode = true
# Staging/production muốn nhận thanh toán gần thật thì đặt false
# =====================
SEPAY_MOCK_MODE=true
SEPAY_API_BASE_URL=https://my.sepay.vn/userapi
SEPAY_API_TOKEN=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT_ID=
SEPAY_BANK_BIN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# =====================
# Supabase Storage
# Cần cho upload ảnh sản phẩm
# Giữ cả anon key và key phía server nếu hệ thống đang dùng song song
# =====================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_server_side_key
